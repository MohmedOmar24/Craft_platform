# =========================
# Build stage
# =========================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["CraftPlatform.Inventory.Api/CraftPlatform.Inventory.Api.csproj", "CraftPlatform.Inventory.Api/"]
COPY ["CraftPlatform.Inventory.Core/CraftPlatform.Inventory.Core.csproj", "CraftPlatform.Inventory.Core/"]
COPY ["CraftPlatform.Inventory.Infrastructure/CraftPlatform.Inventory.Infrastructure.csproj", "CraftPlatform.Inventory.Infrastructure/"]
COPY ["CraftPlatform.Inventory.Services/CraftPlatform.Inventory.Services.csproj", "CraftPlatform.Inventory.Services/"]
COPY ["CraftPlatform.Inventory.Shared/CraftPlatform.Inventory.Shared.csproj", "CraftPlatform.Inventory.Shared/"]

RUN dotnet restore "CraftPlatform.Inventory.Api/CraftPlatform.Inventory.Api.csproj"

COPY . .

WORKDIR "/src/CraftPlatform.Inventory.Api"

RUN dotnet build "CraftPlatform.Inventory.Api.csproj" \
    -c Release \
    -o /app/build
# =========================
# Publish stage
# =========================
FROM build AS publish

RUN dotnet publish "CraftPlatform.Inventory.Api.csproj" \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false

# =========================
# Runtime stage
# =========================
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

COPY --from=publish /app/publish .

ENTRYPOINT ["dotnet", "CraftPlatform.Inventory.Api.dll"]
